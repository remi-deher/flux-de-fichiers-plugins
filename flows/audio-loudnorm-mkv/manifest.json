{
  "schemaVersion": "1.1.0",
  "id": "flow.audio.loudnorm",
  "type": "flow",
  "version": "1.0.0",
  "name": "Normalisation audio EBU R128",
  "description": "Normalise le volume audio selon EBU R128 (loudnorm) en conservant la piste vidéo et les sous-titres.",
  "author": "flux-de-fichiers",
  "license": "GPL-2.0-or-later",
  "capability": "encode",
  "fileMask": "*.mkv, *.mp4, *.flac, *.m4a",
  "isDefault": false,
  "definition": {
    "nodes": [
      {
        "id": "node-1",
        "type": "file-input",
        "name": "Fichier source"
      },
      {
        "id": "node-2",
        "type": "audio-encode",
        "name": "Normalisation audio EBU R128",
        "config": {
          "codec": "aac",
          "bitrate": "192",
          "channels": "preserve",
          "normalize": true
        }
      },
      {
        "id": "node-3",
        "type": "file-output",
        "name": "Sortie fichier",
        "config": {
          "mode": "replace"
        }
      }
    ],
    "connections": [
      { "from": "node-1", "to": "node-2" },
      { "from": "node-2", "to": "node-3" }
    ]
  },
  "dependencies": [
    { "id": "plugin.audio", "versionRange": "^1.0.0", "kind": "plugin" },
    { "id": "plugin.core", "versionRange": "^1.0.0", "kind": "plugin" }
  ]
}
