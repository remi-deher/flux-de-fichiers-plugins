{
  "schemaVersion": "1.0.0",
  "id": "flow.default.mkv",
  "type": "flow",
  "version": "1.0.0",
  "name": "Remuxage Matroska propre",
  "description": "Inspection préalable des métadonnées, filtrage des langues audio/sous-titres voulues et remuxage sans perte.",
  "fileMask": "*.mkv, *.avi, *.mp4",
  "isDefault": true,
  "definition": {
    "nodes": [
      { "id": "node-1", "type": "file-input", "name": "Fichier source" },
      { "id": "node-2", "type": "remux-mkv", "name": "Remux MKV (MKVToolNix)", "config": { "languages": ["fre", "eng"] } },
      { "id": "node-3", "type": "file-output", "name": "Destination finale", "config": { "mode": "replace" } }
    ],
    "connections": [
      { "from": "node-1", "to": "node-2" },
      { "from": "node-2", "to": "node-3" }
    ]
  },
  "dependencies": [
    { "id": "app.mkvtoolnix", "versionRange": "^1.0.0", "kind": "app" }
  ]
}
