{
  "schemaVersion": "1.1.0",
  "id": "remux-matroska",
  "type": "flow",
  "version": "1.0.0",
  "name": "Conversion MKV",
  "description": "Convertit proprement le fichier au format MKV sans perte de qualité.",
  "author": "flux-de-fichiers",
  "license": "GPL-2.0-or-later",
  "capability": "remux",
  "fileMask": "*.mkv, *.avi, *.mp4",
  "isDefault": true,
  "definition": {
    "nodes": [
      {
        "id": "node-1",
        "type": "file-input",
        "name": "Fichier source"
      },
      {
        "id": "node-2",
        "type": "remux-mkv",
        "name": "Remux MKV (MKVToolNix)",
        "config": {
          "languages": [
            "fre",
            "eng"
          ]
        }
      },
      {
        "id": "node-3",
        "type": "file-output",
        "name": "Destination finale",
        "config": {
          "mode": "replace"
        }
      }
    ],
    "connections": [
      {
        "from": "node-1",
        "to": "node-2"
      },
      {
        "from": "node-2",
        "to": "node-3"
      }
    ]
  },
  "dependencies": [
    {
      "id": "video",
      "versionRange": "^1.0.0",
      "kind": "plugin"
    }
  ]
}
