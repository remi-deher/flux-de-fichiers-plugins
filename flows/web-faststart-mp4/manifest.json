{
  "schemaVersion": "1.1.0",
  "id": "flow.remux.mp4",
  "type": "flow",
  "version": "1.0.0",
  "name": "MP4 Streaming",
  "description": "Convertit en MP4 optimisé pour le streaming web.",
  "author": "flux-de-fichiers",
  "license": "GPL-2.0-or-later",
  "capability": "faststart",
  "fileMask": "*.mp4, *.m4v, *.mov",
  "isDefault": false,
  "definition": {
    "nodes": [
      {
        "id": "node-1",
        "type": "file-input",
        "name": "Fichier source"
      },
      {
        "id": "node-2",
        "type": "remux-mp4",
        "name": "Remux MP4 (MP4Box)",
        "config": {
          "faststart": true
        }
      },
      {
        "id": "node-3",
        "type": "file-output",
        "name": "Destination finale",
        "config": {
          "mode": "replace"
        }
      }
    ],
    "connections": [
      {
        "from": "node-1",
        "to": "node-2"
      },
      {
        "from": "node-2",
        "to": "node-3"
      }
    ]
  },
  "dependencies": [
    {
      "id": "plugin.video",
      "versionRange": "^1.0.0",
      "kind": "plugin"
    }
  ]
}
