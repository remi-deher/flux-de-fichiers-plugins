{
  "schemaVersion": "1.1.0",
  "id": "flow.smart.adr0008",
  "type": "flow",
  "version": "1.0.0",
  "name": "Smartarr HEVC (In-Place)",
  "description": "Inspecte automatiquement le média : si déjà HEVC, applique les drapeaux en-têtes directement en place (mkvpropedit) sans copie ; sinon transcode par GPU avec repli CPU garanti.",
  "author": "flux-de-fichiers",
  "license": "GPL-2.0-or-later",
  "capability": "in-place",
  "fileMask": "*.mkv, *.mp4, *.m2ts, *.ts",
  "isDefault": false,
  "definition": {
    "nodes": [
      {
        "id": "node-1",
        "type": "file-input",
        "name": "Fichier source"
      },
      {
        "id": "node-2",
        "type": "condition",
        "name": "Condition : Codec == HEVC ?",
        "config": {
          "property": "tracks[type=video].codec",
          "operator": "eq",
          "target": "hevc"
        }
      },
      {
        "id": "node-3",
        "type": "mkvpropedit",
        "name": "Édition En-têtes (In-Place)",
        "config": {
          "default_audio_lang": "fre",
          "force_subtitles": true
        }
      },
      {
        "id": "node-4",
        "type": "video-encode",
        "name": "Transcodage Vidéo HEVC",
        "config": {
          "codec": "hevc",
          "encoder": "qsv",
          "quality": 6
        }
      },
      {
        "id": "node-5",
        "type": "file-output",
        "name": "Destination & Notification",
        "config": {
          "mode": "replace",
          "notify_arr": true
        }
      }
    ],
    "connections": [
      {
        "from": "node-1",
        "to": "node-2"
      },
      {
        "from": "node-2",
        "to": "node-3",
        "port": "true"
      },
      {
        "from": "node-2",
        "to": "node-4",
        "port": "false"
      },
      {
        "from": "node-3",
        "to": "node-5"
      },
      {
        "from": "node-4",
        "to": "node-5"
      }
    ]
  },
  "dependencies": [
    {
      "id": "plugin.video",
      "versionRange": "^1.0.0",
      "kind": "plugin"
    }
  ]
}
