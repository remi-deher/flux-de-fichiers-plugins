{
  "schemaVersion": "1.1.0",
  "id": "media",
  "type": "pack",
  "version": "1.0.0",
  "name": "Pack Média",
  "description": "Pack complet pour analyser, convertir et organiser vos médias.",
  "author": "flux-de-fichiers",
  "license": "GPL-2.0-or-later",
  "files": [
    {
      "path": "README.md",
      "role": "docs",
      "mediaType": "text/markdown"
    },
    {
      "path": "installation.json",
      "role": "config",
      "mediaType": "application/json"
    }
  ],
  "pack": {
    "kind": "declarative-bundle",
    "installation": "installation.json",
    "runtimeImplemented": true
  }
}
