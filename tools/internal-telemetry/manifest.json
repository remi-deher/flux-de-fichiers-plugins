{
  "schemaVersion": "1.1.0",
  "id": "tool.internal.telemetry",
  "type": "tool",
  "version": "0.1.0",
  "name": "Sonde interne de télémétrie",
  "description": "Outil interne distribué (Option B) pour mesurer CPU, RAM, GPU et stockage sur le nœud. Aucune autorisation d'élévation ; lecture de métriques système uniquement.",
  "author": "flux-de-fichiers",
  "license": "UNLICENSED",
  "files": [
    {
      "path": "README.md",
      "role": "docs",
      "mediaType": "text/markdown"
    },
    {
      "path": "distribution.v1.json",
      "role": "config",
      "mediaType": "application/json"
    },
    {
      "path": "capabilities.v1.json",
      "role": "config",
      "mediaType": "application/json"
    }
  ],
  "compatibility": {
    "platforms": ["linux/amd64", "linux/arm64"]
  },
  "dependencies": [],
  "tool": {
    "capability": "other",
    "interface": "NodeTelemetryProbe",
    "invocation": "host-binary",
    "currentChoice": true
  }
}
