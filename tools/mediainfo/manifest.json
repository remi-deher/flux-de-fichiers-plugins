{
  "schemaVersion": "1.1.0",
  "id": "tool.mediainfo",
  "type": "tool",
  "version": "1.0.0",
  "name": "MediaInfo CLI",
  "description": "Outil universel d'analyse et d'extraction de métadonnées techniques multimédias (codecs, résolutions, profils HDR10/Dolby Vision, canaux audio et sous-titres).",
  "author": "flux-de-fichiers",
  "license": "BSD-2-Clause",
  "files": [
    {
      "path": "README.md",
      "role": "docs",
      "mediaType": "text/markdown"
    },
    {
      "path": "distribution.v1.json",
      "role": "config",
      "mediaType": "application/json"
    }
  ],
  "compatibility": {
    "platforms": ["linux/amd64", "linux/arm64"]
  },
  "dependencies": [],
  "tool": {
    "capability": "probe",
    "interface": "MediaInspector",
    "invocation": "host-binary",
    "currentChoice": true
  }
}
