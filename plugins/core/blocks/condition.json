{
  "schemaVersion": "1.1.0",
  "id": "block.core.condition",
  "aliases": ["condition"],
  "version": "1.0.0",
  "name": "Condition",
  "description": "Aiguille vers « Vrai » ou « Faux » selon les métadonnées de sonde.",
  "category": "data",
  "operationId": "operation.core.condition",
  "operationVersion": "1.0.0",
  "sockets": {
    "inputs": [
      {
        "id": "source",
        "label": "Fichier courant",
        "dataType": "file",
        "mediaType": "*/*"
      }
    ],
    "outputs": [
      {
        "id": "true",
        "label": "✓ Vrai",
        "dataType": "file",
        "mediaType": "*/*"
      },
      {
        "id": "false",
        "label": "✗ Faux",
        "dataType": "file",
        "mediaType": "*/*"
      }
    ]
  },
  "ui": {
    "category": "Logique",
    "domain": "logic",
    "ports": [
      { "id": "true", "label": "✓ Vrai" },
      { "id": "false", "label": "✗ Faux" }
    ],
    "icon": "fas fa-code-branch",
    "color": "#22C55E",
    "suggestedNext": [
      "block.video.encode",
      "block.audio.encode",
      "block.video.remux-mkv",
      "block.core.file-output"
    ],
    "fields": [
      {
        "name": "property",
        "label": "Propriété (chemin JSON)",
        "type": "string",
        "default": "any",
        "required": true,
        "description": "Chemin dans les métadonnées de sonde (ex. format, tracks[type=video].codec) ou any.",
        "placeholder": "any"
      },
      {
        "name": "operator",
        "label": "Opérateur",
        "type": "select",
        "default": "eq",
        "required": true,
        "description": "Comparaison textuelle insensible à la casse ou numérique.",
        "options": [
          { "label": "Contient la valeur", "value": "eq" },
          { "label": "Ne contient pas la valeur", "value": "neq" },
          { "label": "Correspond exactement", "value": "exact" },
          { "label": "Est défini (non vide)", "value": "exists" },
          { "label": "Est absent (ou vide)", "value": "not_exists" },
          { "label": "Supérieur à (>)", "value": "gt" },
          { "label": "Supérieur ou égal (>=)", "value": "gte" },
          { "label": "Inférieur à (<)", "value": "lt" },
          { "label": "Inférieur ou égal (<=)", "value": "lte" }
        ]
      },
      {
        "name": "target",
        "label": "Valeur",
        "type": "string",
        "default": "",
        "required": false,
        "description": "Valeur attendue (inutile pour « Est défini » / « Est absent »)."
      }
    ]
  }
}
