{
  "schemaVersion": "1.1.0",
  "id": "operation.sonarr.rename",
  "version": "1.0.0",
  "name": "Sonarr : renommer l'épisode",
  "providerId": "sonarr",
  "providerKind": "plugin",
  "capability": "integration",
  "status": "validated",
  "runtime": {
    "kind": "http",
    "settingsPluginId": "sonarr",
    "requiredSettings": ["url", "apiKey"],
    "errorCode": "integration_failed",
    "failOnErrorParam": "fail_on_error",
    "timeoutSeconds": 15,
    "pathMapping": {
      "localKey": "pathMappingLocal",
      "remoteKey": "pathMappingRemote",
      "outputVar": "remotePath"
    },
    "steps": [
      {
        "url": "{$setting.url}/api/v3/series",
        "method": "GET",
        "headers": {
          "X-Api-Key": "{$setting.apiKey}"
        },
        "extract": {
          "kind": "arrayPathPrefix",
          "pathField": "path",
          "idField": "id",
          "targetVar": "remotePath",
          "saveAs": "itemId",
          "savePathAs": "itemPath",
          "skipMessage": "média non suivi par Sonarr"
        }
      },
      {
        "url": "{$setting.url}/api/v3/episodefile",
        "method": "GET",
        "query": {
          "seriesId": "{$var.itemId}"
        },
        "headers": {
          "X-Api-Key": "{$setting.apiKey}"
        },
        "extract": {
          "kind": "arrayRelativePath",
          "pathField": "relativePath",
          "absolutePathField": "path",
          "basePathVar": "itemPath",
          "targetVar": "remotePath",
          "idField": "id",
          "saveAs": "fileId",
          "skipMessage": "aucun fichier à renommer dans Sonarr"
        }
      },
      {
        "url": "{$setting.url}/api/v3/command",
        "method": "POST",
        "headers": {
          "X-Api-Key": "{$setting.apiKey}"
        },
        "body": {
          "name": "RenameFiles",
          "seriesId": { "$var": "itemId" },
          "files": [{ "$var": "fileId" }]
        },
        "successMessage": "commande *arr transmise"
      }
    ]
  }
}
