{
  "schemaVersion": "1.1.0",
  "id": "audio",
  "type": "plugin",
  "version": "1.0.0",
  "name": "Audio",
  "description": "Conversion et normalisation des pistes audio.",
  "author": "Forgearr",
  "license": "GPL-2.0-or-later",
  "capability": "audio",
  "category": "media",
  "subcategory": "media-encoding",
  "icon": "icon.svg",
  "files": [
    {
      "path": "README.md",
      "role": "docs",
      "mediaType": "text/markdown"
    },
    {
      "path": "blocks/audio-encode.json",
      "role": "block",
      "mediaType": "application/json"
    },
    {
      "path": "operations/audio-encode.json",
      "role": "operation",
      "mediaType": "application/json"
    }
  ],
  "dependencies": [
    {
      "id": "ffmpeg",
      "versionRange": "^1.0.0",
      "kind": "app",
      "optional": true
    }
  ],
  "compatibility": {
    "appMin": "1.0.0",
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ]
  }
}
