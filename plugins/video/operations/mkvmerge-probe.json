{
  "schemaVersion": "1.1.0",
  "id": "operation.mkvtoolnix.probe",
  "version": "1.0.0",
  "name": "Sonde de conteneur MKVToolNix (mkvmerge -J)",
  "providerId": "plugin.video",
  "providerKind": "plugin",
  "capability": "probe",
  "status": "validated",
  "runtime": {
    "kind": "binary",
    "tool": { "id": "app.mkvtoolnix", "version": "1.0.0" },
    "executable": "mkvmerge",
    "envOverride": "MKVMERGE",
    "executionMode": "probe-primary",
    "probeFormat": "mkvmerge-json",
    "errorCode": "remux_failed",
    "argv": [
      "--output-charset",
      "UTF-8",
      "-J",
      { "param": "source", "as": "filePath" }
    ],
    "console": {
      "progressFormat": "none",
      "progressStream": "stdout",
      "successExitCodes": [0, 1],
      "warningExitCodes": [1],
      "timeoutSeconds": 60
    }
  }
}
