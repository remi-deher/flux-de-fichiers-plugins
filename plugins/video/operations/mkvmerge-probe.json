{
  "schemaVersion": "1.1.0",
  "id": "operation.mkvtoolnix.probe",
  "version": "1.0.0",
  "name": "Sonde de conteneur MKVToolNix (mkvmerge -J)",
  "providerId": "video",
  "providerKind": "plugin",
  "capability": "probe",
  "status": "validated",
  "runtime": {
    "kind": "binary",
    "tool": { "id": "mkvtoolnix", "version": "1.0.0" },
    "executable": "mkvmerge",
    "envOverride": "MKVMERGE",
    "executionMode": "probe-primary",
    "probeFormat": "json",
    "probeMatch": {
      "extensions": ["mkv", "mka", "mks", "mk3d", "webm", "mp4", "m4v", "m4a", "mov", "avi", "ts", "m2ts", "mts", "flv", "mpg", "mpeg", "wmv", "ogv", "ogg"]
    },
    "probeRequirePaths": ["container.recognized", "container.supported", "tracks"],
    "durationRules": [{ "path": "container.properties.duration", "scale": 1e-9 }],
    "errorCode": "operation_failed",
    "argv": [
      "--output-charset",
      "UTF-8",
      "-J",
      { "param": "source", "as": "filePath" }
    ],
    "console": {
      "progressFormat": "none",
      "progressStream": "stdout",
      "successExitCodes": [0, 1],
      "warningExitCodes": [1],
      "timeoutSeconds": 60
    }
  }
}
