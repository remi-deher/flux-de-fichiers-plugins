{
  "schemaVersion": "1.1.0",
  "id": "operation.ffmpeg.video.encode",
  "version": "1.1.0",
  "name": "Encodage vidéo FFmpeg",
  "providerId": "video",
  "providerKind": "plugin",
  "capability": "encode",
  "status": "validated",
  "runtime": {
    "kind": "binary",
    "tool": {
      "id": "ffmpeg",
      "version": "1.0.0"
    },
    "executable": "ffmpeg",
    "envOverride": "FFMPEG",
    "executionMode": "staged-output",
    "outputExtension": "mkv",
    "outputContentType": "video/x-matroska",
    "outputFilename": "encoded.mkv",
    "postValidate": "valid-probe",
    "errorCode": "operation_failed",
    "successMessage": "encodage terminé",
    "defaults": {
      "codec": "h265",
      "encoder": "auto",
      "quality": 6,
      "speed": 3,
      "custom_parameters": "",
      "video_mode": "encode",
      "audio_codec": "copy",
      "audio_language": "",
      "subtitle_language": "",
      "keep_subtitles": true
    },
    "customArgsForbidden": [
      "-i",
      "-y",
      "-n",
      "-filter_script",
      "-filter_complex_script",
      "-progress",
      "-report",
      "-sdp_file",
      "-passlogfile",
      "-vstats_file",
      "-attach",
      "-dump_attachment"
    ],
    "derived": [
      {
        "target": "crf",
        "kind": "map",
        "inputs": [
          "quality"
        ],
        "table": {
          "1": "32",
          "2": "30",
          "3": "28",
          "4": "26",
          "5": "24",
          "6": "22",
          "7": "20",
          "8": "18",
          "9": "16"
        },
        "default": "22"
      },
      {
        "target": "cpu_preset",
        "kind": "map",
        "inputs": [
          "speed"
        ],
        "table": {
          "1": "veryslow",
          "2": "slow",
          "3": "medium",
          "4": "fast",
          "5": "veryfast"
        },
        "default": "medium"
      },
      {
        "target": "nvenc_preset",
        "kind": "map",
        "inputs": [
          "speed"
        ],
        "table": {
          "1": "p7",
          "2": "p6",
          "3": "p4",
          "4": "p2",
          "5": "p1"
        },
        "default": "p4"
      },
      {
        "target": "svtav1_preset",
        "kind": "map",
        "inputs": [
          "speed"
        ],
        "table": {
          "1": "4",
          "2": "6",
          "3": "8",
          "4": "10",
          "5": "12"
        },
        "default": "8"
      },
      {
        "target": "video_encoder",
        "kind": "map",
        "inputs": [
          "codec",
          "encoder"
        ],
        "table": {
          "h264|nvidia": "h264_nvenc",
          "h264|intel_qsv": "h264_qsv",
          "h264|vaapi": "h264_vaapi",
          "h264|amd_amf": "h264_amf",
          "h264|*": "libx264",
          "h265|nvidia": "hevc_nvenc",
          "h265|intel_qsv": "hevc_qsv",
          "h265|vaapi": "hevc_vaapi",
          "h265|amd_amf": "hevc_amf",
          "h265|*": "libx265",
          "h265_10bit|nvidia": "hevc_nvenc",
          "h265_10bit|intel_qsv": "hevc_qsv",
          "h265_10bit|vaapi": "hevc_vaapi",
          "h265_10bit|amd_amf": "hevc_amf",
          "h265_10bit|*": "libx265",
          "av1|nvidia": "av1_nvenc",
          "av1|intel_qsv": "av1_qsv",
          "av1|*": "libsvtav1",
          "av1_10bit|nvidia": "av1_nvenc",
          "av1_10bit|intel_qsv": "av1_qsv",
          "av1_10bit|*": "libsvtav1",
          "vp9|*": "libvpx-vp9"
        },
        "default": "libx265"
      }
    ],
    "argv": [
      "-nostdin",
      "-y",
      "-hide_banner",
      "-i",
      {
        "param": "source",
        "as": "filePath"
      },
      {
        "when": {
          "all": [
            {
              "param": "audio_language",
              "nonEmpty": false
            },
            {
              "param": "subtitle_language",
              "nonEmpty": false
            },
            {
              "param": "keep_subtitles",
              "truthy": true
            }
          ]
        },
        "then": [
          "-map",
          "0"
        ],
        "else": [
          "-map",
          "0:v?",
          "-map",
          {
            "when": {
              "param": "audio_language",
              "nonEmpty": true
            },
            "then": [
              {
                "format": "0:a:m:language:{audio_language}"
              }
            ],
            "else": [
              "0:a?"
            ]
          },
          {
            "when": {
              "param": "keep_subtitles",
              "truthy": true
            },
            "then": [
              "-map",
              {
                "when": {
                  "param": "subtitle_language",
                  "nonEmpty": true
                },
                "then": [
                  {
                    "format": "0:s:m:language:{subtitle_language}"
                  }
                ],
                "else": [
                  "0:s?"
                ]
              }
            ]
          },
          "-map",
          "0:t?"
        ]
      },
      {
        "when": {
          "param": "video_mode",
          "eq": "copy"
        },
        "then": [
          "-c:v",
          "copy"
        ],
        "else": [
          "-c:v",
          {
            "param": "video_encoder"
          },
          {
            "when": {
              "param": "encoder",
              "eq": "nvidia"
            },
            "then": [
              "-cq",
              {
                "param": "crf"
              },
              "-preset",
              {
                "param": "nvenc_preset"
              }
            ],
            "else": [
              {
                "when": {
                  "param": "encoder",
                  "eq": "intel_qsv"
                },
                "then": [
                  "-global_quality",
                  {
                    "param": "crf"
                  }
                ],
                "else": [
                  {
                    "when": {
                      "param": "encoder",
                      "eq": "vaapi"
                    },
                    "then": [
                      "-qp",
                      {
                        "param": "crf"
                      }
                    ],
                    "else": [
                      "-crf",
                      {
                        "param": "crf"
                      },
                      "-preset",
                      {
                        "when": {
                          "param": "video_encoder",
                          "eq": "libsvtav1"
                        },
                        "then": [
                          {
                            "param": "svtav1_preset"
                          }
                        ],
                        "else": [
                          {
                            "param": "cpu_preset"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "when": {
              "all": [
                {
                  "param": "codec",
                  "endsWith": "_10bit"
                },
                {
                  "param": "encoder",
                  "neq": "vaapi"
                }
              ]
            },
            "then": [
              "-pix_fmt",
              {
                "when": {
                  "param": "encoder",
                  "in": [
                    "nvidia",
                    "intel_qsv"
                  ]
                },
                "then": [
                  "p010le"
                ],
                "else": [
                  "yuv420p10le"
                ]
              }
            ]
          }
        ]
      },
      "-c:a",
      {
        "when": {
          "param": "audio_codec",
          "eq": "aac"
        },
        "then": [
          "aac"
        ],
        "else": [
          {
            "when": {
              "param": "audio_codec",
              "eq": "opus"
            },
            "then": [
              "libopus"
            ],
            "else": [
              "copy"
            ]
          }
        ]
      },
      "-c:s",
      "copy",
      {
        "param": "custom_parameters",
        "as": "safeCustomArgs"
      },
      {
        "param": "destination",
        "as": "filePath"
      }
    ],
    "retryFallback": [
      {
        "when": {
          "all": [
            {
              "param": "video_mode",
              "neq": "copy"
            },
            {
              "param": "encoder",
              "in": [
                "nvidia",
                "intel_qsv",
                "vaapi",
                "amd_amf"
              ]
            }
          ]
        },
        "overrides": {
          "encoder": "cpu"
        },
        "message": "encodage terminé (repli matériel -> CPU)"
      }
    ],
    "console": {
      "progressFormat": "elapsed-time",
      "progressStream": "stderr",
      "successExitCodes": [
        0
      ],
      "warningExitCodes": [],
      "timeoutSeconds": 3600
    }
  }
}
