{
  "schemaVersion": "1.1.0",
  "id": "video.remux-mp4",
  "aliases": [
    "remux-mp4"
  ],
  "version": "1.0.0",
  "name": "Remux MP4",
  "description": "Convertit le fichier en MP4 optimisé pour la lecture en streaming.",
  "category": "media",
  "operationId": "operation.mp4box.remux",
  "operationVersion": "1.0.0",
  "sockets": {
    "inputs": [
      {
        "id": "source",
        "label": "Fichier source (MKV, AVI, MOV, TS)",
        "dataType": "file",
        "mediaType": "video/*"
      }
    ],
    "outputs": [
      {
        "id": "destination",
        "label": "Fichier cible MP4 optimisé",
        "dataType": "file",
        "mediaType": "video/mp4"
      }
    ]
  },
  "ui": {
    "category": "Média",
    "domain": "video",
    "icon": "fas fa-film",
    "color": "#3F51B5",
    "suggestedNext": [
      "sonarr.rescan",
      "radarr.rescan",
      "essentiel.webhook",
      "essentiel.file-output"
    ],
    "fields": [
      {
        "name": "faststart",
        "label": "Optimisation streaming (moov au début)",
        "type": "boolean",
        "default": true,
        "description": "Indispensable pour débuter la lecture immédiatement sans devoir charger tout le fichier vidéo."
      },
      {
        "name": "custom_parameters",
        "label": "Paramètres personnalisés (MP4Box)",
        "type": "string",
        "default": "",
        "description": "Options additionnelles MP4Box (ex: -lang fr -brand mp42)."
      }
    ]
  }
}
