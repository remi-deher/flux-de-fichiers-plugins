{
  "schemaVersion": "1.1.0",
  "id": "video.mkvpropedit",
  "aliases": [
    "mkvpropedit"
  ],
  "version": "1.0.0",
  "name": "MKVPropEdit",
  "description": "Modifie les langues et pistes par défaut d'un MKV sans le réécrire.",
  "category": "media",
  "operationId": "operation.mkvtoolnix.mkvpropedit",
  "operationVersion": "1.0.0",
  "sockets": {
    "inputs": [
      {
        "id": "source",
        "label": "Fichier Matroska (.mkv)",
        "dataType": "file",
        "mediaType": "video/x-matroska"
      }
    ],
    "outputs": [
      {
        "id": "destination",
        "label": "Fichier MKV mis à jour",
        "dataType": "file",
        "mediaType": "video/x-matroska"
      }
    ]
  },
  "ui": {
    "category": "MKVToolNix",
    "domain": "mkv",
    "icon": "fas fa-tags",
    "color": "#00BCD4",
    "suggestedNext": [
      "sonarr.rescan",
      "radarr.rescan",
      "essentiel.webhook",
      "essentiel.file-output"
    ],
    "fields": [
      {
        "name": "default_audio_lang",
        "label": "Langue audio par défaut",
        "type": "string",
        "default": "",
        "description": "Code ISO 639-2, par exemple fre."
      },
      {
        "name": "force_subtitles",
        "label": "Marquer les sous-titres forcés",
        "type": "boolean",
        "default": false
      }
    ]
  }
}
