{
  "schemaVersion": "1.1.0",
  "id": "video.encode",
  "aliases": [
    "video-encode"
  ],
  "version": "1.1.0",
  "name": "Traitement vidéo, audio et sous-titres",
  "description": "Remuxe ou encode la vidéo et configure les pistes audio et sous-titres en un passage FFmpeg.",
  "category": "media",
  "operationId": "operation.ffmpeg.video.encode",
  "operationVersion": "1.1.0",
  "sockets": {
    "inputs": [
      {
        "id": "source",
        "label": "Fichier source",
        "dataType": "file",
        "mediaType": "video/*"
      }
    ],
    "outputs": [
      {
        "id": "destination",
        "label": "Fichier encodé",
        "dataType": "file",
        "mediaType": "video/*"
      }
    ]
  },
  "ui": {
    "category": "Média",
    "domain": "video",
    "icon": "fas fa-film",
    "color": "#E91E63",
    "suggestedNext": [
      "video.remux-mkv",
      "video.mkvpropedit",
      "sonarr.rescan",
      "radarr.rescan",
      "essentiel.file-output"
    ],
    "fields": [
      {
        "name": "video_mode",
        "label": "Traitement vidéo",
        "type": "select",
        "default": "encode",
        "options": [
          {
            "label": "Encoder",
            "value": "encode"
          },
          {
            "label": "Copier (remux)",
            "value": "copy"
          }
        ]
      },
      {
        "name": "codec",
        "label": "Codec",
        "type": "select",
        "default": "h265",
        "options": [
          {
            "label": "H.264",
            "value": "h264"
          },
          {
            "label": "HEVC (Automatic)",
            "value": "h265"
          },
          {
            "label": "HEVC (10-Bit)",
            "value": "h265_10bit"
          },
          {
            "label": "AV1",
            "value": "av1"
          },
          {
            "label": "AV1 (10-Bit)",
            "value": "av1_10bit"
          },
          {
            "label": "VP9",
            "value": "vp9"
          }
        ]
      },
      {
        "name": "encoder",
        "label": "Encodeur",
        "type": "select",
        "default": "auto",
        "description": "L'encodeur à utiliser. Si vous spécifiez un encodeur matériel indisponible, l'encodage échouera.",
        "options": [
          {
            "label": "Automatique",
            "value": "auto"
          },
          {
            "label": "Processeur (CPU)",
            "value": "cpu"
          },
          {
            "label": "NVIDIA (NVENC)",
            "value": "nvidia"
          },
          {
            "label": "Intel QSV",
            "value": "intel_qsv"
          },
          {
            "label": "VAAPI (Linux)",
            "value": "vaapi"
          },
          {
            "label": "AMD AMF",
            "value": "amd_amf"
          }
        ]
      },
      {
        "name": "quality",
        "label": "Qualité",
        "type": "range",
        "min": 1,
        "max": 9,
        "default": 6,
        "description": "Des valeurs plus élevées offrent une meilleure qualité et des fichiers plus volumineux. Des valeurs plus basses réduisent la qualité et la taille du fichier."
      },
      {
        "name": "speed",
        "label": "Vitesse",
        "type": "range",
        "min": 1,
        "max": 5,
        "default": 3,
        "description": "Un encodage plus rapide réduit l'efficacité de la compression, ce qui entraîne une qualité inférieure ou des fichiers plus volumineux."
      },
      {
        "name": "audio_codec",
        "label": "Codec audio",
        "type": "select",
        "default": "copy",
        "options": [
          {
            "label": "Copier",
            "value": "copy"
          },
          {
            "label": "AAC",
            "value": "aac"
          },
          {
            "label": "Opus",
            "value": "opus"
          }
        ]
      },
      {
        "name": "audio_language",
        "label": "Langue audio",
        "type": "string",
        "default": "",
        "description": "Code de langue de la piste, par exemple fra ou eng. Vide pour conserver toutes les langues."
      },
      {
        "name": "keep_subtitles",
        "label": "Conserver les sous-titres",
        "type": "boolean",
        "default": true
      },
      {
        "name": "subtitle_language",
        "label": "Langue des sous-titres",
        "type": "string",
        "default": "",
        "description": "Code de langue de la piste, par exemple fra ou eng. Vide pour conserver toutes les langues."
      },
      {
        "name": "custom_parameters",
        "label": "Paramètres d'encodage personnalisés (FFmpeg)",
        "type": "string",
        "default": "",
        "description": "Arguments FFmpeg additionnels injectés à la ligne de commande (ex: -tune film -bf 3)."
      }
    ]
  }
}
