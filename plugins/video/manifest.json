{
  "schemaVersion": "1.1.0",
  "id": "video",
  "type": "plugin",
  "version": "1.0.0",
  "name": "Vidéo",
  "description": "Analyse, conversion et réencodage vidéo (MKV, MP4, HEVC, AV1).",
  "author": "flux-de-fichiers",
  "license": "GPL-2.0-or-later",
  "capability": "video",
  "files": [
    {
      "path": "README.md",
      "role": "docs",
      "mediaType": "text/markdown"
    },
    {
      "path": "blocks/video-encode.json",
      "role": "block",
      "mediaType": "application/json"
    },
    {
      "path": "blocks/remux-mkv.json",
      "role": "block",
      "mediaType": "application/json"
    },
    {
      "path": "blocks/remux-mp4.json",
      "role": "block",
      "mediaType": "application/json"
    },
    {
      "path": "blocks/media-inspect.json",
      "role": "block",
      "mediaType": "application/json"
    },
    {
      "path": "blocks/mkvpropedit.json",
      "role": "block",
      "mediaType": "application/json"
    },
    {
      "path": "operations/mkvmerge-probe.json",
      "role": "operation",
      "mediaType": "application/json"
    },
    {
      "path": "operations/media-inspect.json",
      "role": "operation",
      "mediaType": "application/json"
    },
    {
      "path": "operations/remux-mkv.json",
      "role": "operation",
      "mediaType": "application/json"
    },
    {
      "path": "operations/mkvpropedit.json",
      "role": "operation",
      "mediaType": "application/json"
    },
    {
      "path": "operations/remux-mp4.json",
      "role": "operation",
      "mediaType": "application/json"
    },
    {
      "path": "operations/video-encode.json",
      "role": "operation",
      "mediaType": "application/json"
    }
  ],
  "dependencies": [
    {
      "id": "ffmpeg",
      "versionRange": "^1.0.0",
      "kind": "app",
      "optional": true
    },
    {
      "id": "mkvtoolnix",
      "versionRange": "^1.0.0",
      "kind": "app",
      "optional": true
    },
    {
      "id": "mp4box",
      "versionRange": "^1.0.0",
      "kind": "app",
      "optional": true
    },
    {
      "id": "mediainfo",
      "versionRange": "^1.0.0",
      "kind": "app",
      "optional": true
    }
  ],
  "compatibility": {
    "appMin": "1.0.0",
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ]
  }
}
