{
  "schemaVersion": "1.1.0",
  "id": "scripts",
  "type": "plugin",
  "version": "1.1.0",
  "name": "Scripts",
  "description": "Exécution de scripts personnalisés avec aiguillage conditionnel.",
  "author": "Forgearr",
  "license": "GPL-3.0-or-later",
  "category": "data",
  "subcategory": "scripting",
  "capability": "script",
  "icon": "icon.svg",
  "files": [
    {
      "path": "README.md",
      "role": "docs",
      "mediaType": "text/markdown"
    },
    {
      "path": "blocks/run.json",
      "role": "block",
      "mediaType": "application/json"
    },
    {
      "path": "operations/run.json",
      "role": "operation",
      "mediaType": "application/json"
    }
  ],
  "compatibility": {
    "appMin": "1.0.0",
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ]
  },
  "dependencies": [
    {
      "id": "interpreteurs",
      "versionRange": "^1.0.0",
      "kind": "app",
      "optional": true
    }
  ]
}
