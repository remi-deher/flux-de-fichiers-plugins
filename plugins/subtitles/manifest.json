{
  "schemaVersion": "1.1.0",
  "id": "plugin.subtitles",
  "type": "plugin",
  "version": "1.0.0",
  "name": "Sous-titres",
  "description": "Filtrage par langue et gestion des drapeaux par défaut/forcés des pistes de sous-titres et audio.",
  "author": "flux-de-fichiers",
  "license": "GPL-2.0-or-later",
  "capability": "other",
  "files": [
    {
      "path": "README.md",
      "role": "docs",
      "mediaType": "text/markdown"
    },
    {
      "path": "blocks/subtitles-clean.json",
      "role": "block",
      "mediaType": "application/json"
    },
    {
      "path": "blocks/subtitles-flags.json",
      "role": "block",
      "mediaType": "application/json"
    },
    {
      "path": "operations/subtitles-clean.json",
      "role": "operation",
      "mediaType": "application/json"
    },
    {
      "path": "operations/subtitles-flags.json",
      "role": "operation",
      "mediaType": "application/json"
    }
  ],
  "dependencies": [
    {
      "id": "app.mkvtoolnix",
      "versionRange": "^1.0.0",
      "kind": "app",
      "optional": true
    }
  ],
  "compatibility": {
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ]
  }
}
