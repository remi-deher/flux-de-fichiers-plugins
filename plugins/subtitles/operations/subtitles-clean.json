{
  "schemaVersion": "1.1.0",
  "id": "operation.mkvtoolnix.subtitles.clean",
  "version": "1.0.0",
  "name": "Filtrage des pistes sous-titres et audio (mkvmerge)",
  "providerId": "plugin.subtitles",
  "providerKind": "plugin",
  "capability": "remux",
  "status": "validated",
  "runtime": {
    "kind": "binary",
    "tool": { "id": "app.mkvtoolnix", "version": "1.0.0" },
    "executable": "mkvmerge",
    "envOverride": "MKVMERGE",
    "executionMode": "staged-output",
    "outputExtension": "mkv",
    "outputContentType": "video/x-matroska",
    "outputFilename": "subtitles-cleaned.mkv",
    "postValidate": "valid-probe",
    "errorCode": "operation_failed",
    "successMessage": "pistes sous-titres filtrées",
    "defaults": {
      "subtitle_languages": "fre,eng",
      "audio_languages": "all",
      "disable_track_stats": true
    },
    "argv": [
      "--output-charset",
      "UTF-8",
      {
        "when": { "param": "disable_track_stats", "truthy": true },
        "then": ["--disable-track-statistics-tags"]
      },
      {
        "when": {
          "all": [
            { "param": "audio_languages", "nonEmpty": true },
            { "param": "audio_languages", "neq": "all" }
          ]
        },
        "then": [
          {
            "when": { "param": "audio_languages", "eq": "none" },
            "then": ["--no-audio"],
            "else": ["--audio-tracks", { "param": "audio_languages" }]
          }
        ]
      },
      {
        "when": {
          "all": [
            { "param": "subtitle_languages", "nonEmpty": true },
            { "param": "subtitle_languages", "neq": "all" }
          ]
        },
        "then": [
          {
            "when": { "param": "subtitle_languages", "eq": "none" },
            "then": ["--no-subtitles"],
            "else": ["--subtitle-tracks", { "param": "subtitle_languages" }]
          }
        ]
      },
      "-o",
      { "param": "destination", "as": "filePath" },
      { "param": "source", "as": "filePath" }
    ],
    "console": {
      "progressFormat": "fraction-100",
      "progressStream": "stdout",
      "successExitCodes": [0, 1],
      "warningExitCodes": [1],
      "timeoutSeconds": 1800
    }
  }
}
