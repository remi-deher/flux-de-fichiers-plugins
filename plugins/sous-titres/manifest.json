{
  "schemaVersion": "1.1.0",
  "id": "sous-titres",
  "type": "plugin",
  "version": "1.0.0",
  "name": "Sous-titres",
  "description": "Filtrage par langue, drapeaux par défaut/forcés, resynchronisation (alass) et OCR des sous-titres PGS (Tesseract).",
  "author": "Forgearr",
  "license": "GPL-2.0-or-later",
  "capability": "other",
  "category": "media",
  "subcategory": "media-subtitles",
  "icon": "icon.svg",
  "files": [
    {
      "path": "README.md",
      "role": "docs",
      "mediaType": "text/markdown"
    },
    {
      "path": "blocks/subtitles-clean.json",
      "role": "block",
      "mediaType": "application/json"
    },
    {
      "path": "blocks/subtitles-flags.json",
      "role": "block",
      "mediaType": "application/json"
    },
    {
      "path": "operations/subtitles-clean.json",
      "role": "operation",
      "mediaType": "application/json"
    },
    {
      "path": "operations/subtitles-flags.json",
      "role": "operation",
      "mediaType": "application/json"
    },
    {
      "path": "blocks/sync.json",
      "role": "block",
      "mediaType": "application/json"
    },
    {
      "path": "blocks/ocr.json",
      "role": "block",
      "mediaType": "application/json"
    },
    {
      "path": "operations/sync.json",
      "role": "operation",
      "mediaType": "application/json"
    },
    {
      "path": "operations/ocr.json",
      "role": "operation",
      "mediaType": "application/json"
    },
    {
      "path": "scripts/sous_titres.py",
      "role": "script",
      "mediaType": "text/x-python"
    }
  ],
  "dependencies": [
    {
      "id": "mkvtoolnix",
      "versionRange": "^1.0.0",
      "kind": "app",
      "optional": true
    },
    {
      "id": "alass",
      "versionRange": "^1.0.0",
      "kind": "app",
      "optional": true
    },
    {
      "id": "tesseract",
      "versionRange": "^1.0.0",
      "kind": "app",
      "optional": true
    },
    {
      "id": "ffmpeg",
      "versionRange": "^1.0.0",
      "kind": "app",
      "optional": true
    },
    {
      "id": "interpreteurs",
      "versionRange": "^1.0.0",
      "kind": "app",
      "optional": true
    }
  ],
  "compatibility": {
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ]
  }
}
