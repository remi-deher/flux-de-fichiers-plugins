{
  "schemaVersion": "1.1.0",
  "id": "operation.notifications.apprise",
  "version": "1.0.0",
  "name": "Notification Apprise API",
  "providerId": "notifications",
  "providerKind": "plugin",
  "capability": "notification",
  "status": "validated",
  "runtime": {
    "kind": "http",
    "errorCode": "webhook_failed",
    "failOnErrorParam": "fail_on_error",
    "timeoutSeconds": 10,
    "steps": [
      {
        "url": "{$config.url}/notify",
        "method": "POST",
        "body": {
          "urls": "{$config.targets}",
          "title": "{$config.title|Flux de Fichiers}",
          "body": "{$config.message|Traitement terminé : {$context.sourceName}}"
        },
        "successMessage": "notification Apprise envoyée"
      }
    ]
  }
}
