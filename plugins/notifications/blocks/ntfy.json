{
  "schemaVersion": "1.1.0",
  "id": "block.notifications.ntfy",
  "aliases": ["notify-ntfy"],
  "version": "1.0.0",
  "name": "Notification : Ntfy",
  "description": "Publie une notification sur un sujet Ntfy.",
  "category": "io",
  "operationId": "operation.notifications.ntfy",
  "operationVersion": "1.0.0",
  "sockets": {
