{
  "schemaVersion": "1.1.0",
  "id": "block.notifications.apprise",
  "aliases": ["notify-apprise"],
  "version": "1.0.0",
  "name": "Notification : Apprise",
  "description": "Relaye une notification vers n'importe quel service pris en charge par Apprise API.",
  "category": "io",
  "operationId": "operation.notifications.apprise",
  "operationVersion": "1.0.0",
  "sockets": {
    "inputs": [{ "id": "source", "label": "Fichier courant", "dataType": "file", "mediaType": "*/*" }],
    "outputs": [{ "id": "destination", "label": "Fichier courant", "dataType": "file", "mediaType": "*/*" }]
  },
  "ui": {
    "category": "Notification",
    "domain": "integration",
    "icon": "fas fa-paper-plane",
    "color": "#6366F1",
    "suggestedNext": ["block.core.file-output"],
    "fields": [
      { "name": "url", "label": "URL Apprise API", "type": "string", "required": true },
      { "name": "targets", "label": "URL(s) cibles Apprise", "type": "string", "required": true },
      { "name": "title", "label": "Titre", "type": "string", "default": "Flux de Fichiers" },
      { "name": "message", "label": "Message", "type": "string", "default": "Traitement terminé : {$context.sourceName}" },
      { "name": "fail_on_error", "label": "Échec bloquant", "type": "boolean", "default": false }
    ]
  }
}
