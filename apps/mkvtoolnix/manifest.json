{
  "schemaVersion": "1.1.0",
  "id": "app.mkvtoolnix",
  "type": "app",
  "version": "1.0.0",
  "name": "MKVToolNix",
  "description": "Outil de création et d'édition de fichiers Matroska (.mkv) sans perte de qualité.",
  "author": "flux-de-fichiers",
  "license": "GPL-2.0-or-later",
  "files": [
    {
      "path": "README.md",
      "role": "docs",
      "mediaType": "text/markdown"
    },
    {
      "path": "distribution.v1.json",
      "role": "config",
      "mediaType": "application/json"
    }
  ],
  "compatibility": {
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ]
  },
  "dependencies": [],
  "tool": {
    "capability": "remux",
    "interface": "Remuxer",
    "invocation": "host-binary",
    "currentChoice": true
  }
}
