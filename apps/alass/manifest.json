{
  "schemaVersion": "1.1.0",
  "id": "alass",
  "type": "app",
  "version": "1.0.0",
  "name": "alass (synchronisation de sous-titres)",
  "description": "Resynchronisation automatique d'un sous-titre texte sur la piste audio.",
  "author": "flux-de-fichiers",
  "license": "GPL-3.0-only",
  "files": [
    {
      "path": "README.md",
      "role": "docs",
      "mediaType": "text/markdown"
    },
    {
      "path": "build.json",
      "role": "config",
      "mediaType": "application/json"
    },
    {
      "path": "distribution.v1.json",
      "role": "config",
      "mediaType": "application/json"
    }
  ],
  "compatibility": {
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ]
  },
  "dependencies": [],
  "tool": {
    "capability": "subtitles",
    "interface": "SubtitleSync",
    "invocation": "host-binary",
    "currentChoice": false
  }
}
