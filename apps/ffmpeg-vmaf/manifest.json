{
  "schemaVersion": "1.1.0",
  "id": "ffmpeg-vmaf",
  "type": "app",
  "version": "1.0.0",
  "name": "FFmpeg (VMAF)",
  "description": "FFmpeg statique avec libvmaf et SVT-AV1, pour mesurer la qualité perçue et encoder à qualité cible.",
  "author": "Forgearr",
  "license": "GPL-3.0-or-later",
  "files": [
    {
      "path": "README.md",
      "role": "docs",
      "mediaType": "text/markdown"
    },
    {
      "path": "build.json",
      "role": "config",
      "mediaType": "application/json"
    },
    {
      "path": "distribution.v1.json",
      "role": "config",
      "mediaType": "application/json"
    }
  ],
  "compatibility": {
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ]
  },
  "dependencies": [],
  "tool": {
    "capability": "quality",
    "interface": "QualityMetrics",
    "invocation": "host-binary",
    "currentChoice": false
  }
}
