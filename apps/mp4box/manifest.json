{
  "schemaVersion": "1.1.0",
  "id": "mp4box",
  "type": "app",
  "version": "1.0.0",
  "name": "MP4Box (GPAC)",
  "description": "Outil de conversion et d'optimisation MP4 pour la lecture en streaming.",
  "author": "flux-de-fichiers",
  "license": "LGPL-2.1-or-later",
  "files": [
    {
      "path": "README.md",
      "role": "docs",
      "mediaType": "text/markdown"
    },
    {
      "path": "distribution.v1.json",
      "role": "config",
      "mediaType": "application/json"
    }
  ],
  "compatibility": {
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ]
  },
  "dependencies": [],
  "tool": {
    "capability": "remux-mp4",
    "interface": "Mp4Remuxer",
    "invocation": "host-binary",
    "currentChoice": true
  }
}
