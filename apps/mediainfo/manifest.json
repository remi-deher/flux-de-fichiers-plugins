{
  "schemaVersion": "1.1.0",
  "id": "mediainfo",
  "type": "app",
  "version": "1.0.0",
  "name": "MediaInfo",
  "description": "Analyse les pistes vidéo, audio et sous-titres d'un fichier média.",
  "author": "flux-de-fichiers",
  "license": "BSD-2-Clause",
  "files": [
    {
      "path": "README.md",
      "role": "docs",
      "mediaType": "text/markdown"
    },
    {
      "path": "distribution.v1.json",
      "role": "config",
      "mediaType": "application/json"
    }
  ],
  "compatibility": {
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ]
  },
  "dependencies": [],
  "tool": {
    "capability": "probe",
    "interface": "MediaInspector",
    "invocation": "host-binary",
    "currentChoice": true
  }
}
