{
  "schemaVersion": "1.1.0",
  "id": "app.script-runners",
  "type": "app",
  "version": "1.0.0",
  "name": "Script Runners",
  "description": "Application regroupant les binaires d'exécution de scripts (sh, bash, python3, node, deno, bun, pwsh) pour les workers.",
  "author": "flux-de-fichiers",
  "license": "MIT",
  "files": [
    {
      "path": "README.md",
      "role": "docs",
      "mediaType": "text/markdown"
    },
    {
      "path": "distribution.v1.json",
      "role": "config",
      "mediaType": "application/json"
    }
  ],
  "compatibility": {
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ]
  },
  "dependencies": [],
  "tool": {
    "capability": "script",
    "interface": "ScriptRunner",
    "invocation": "host-binary",
    "currentChoice": false
  }
}
