{
  "schemaVersion": "1.1.0",
  "id": "atomicparsley",
  "type": "app",
  "version": "1.0.0",
  "name": "AtomicParsley",
  "description": "Écriture des tags et jaquettes des fichiers MP4.",
  "author": "flux-de-fichiers",
  "license": "GPL-2.0-or-later",
  "files": [
    {
      "path": "README.md",
      "role": "docs",
      "mediaType": "text/markdown"
    },
    {
      "path": "build.json",
      "role": "config",
      "mediaType": "application/json"
    },
    {
      "path": "distribution.v1.json",
      "role": "config",
      "mediaType": "application/json"
    }
  ],
  "compatibility": {
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ]
  },
  "dependencies": [],
  "tool": {
    "capability": "tags",
    "interface": "Mp4Tagger",
    "invocation": "host-binary",
    "currentChoice": false
  }
}
