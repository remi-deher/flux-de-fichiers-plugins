{
  "schemaVersion": "1.1.0",
  "id": "operation.mkvtoolnix.mkvmerge.remux",
  "version": "1.1.0",
  "name": "Remux Matroska sans réencodage",
  "description": "Exemple déclaratif aligné sur la CLI de src/media.rs, durci #40. Aucune exécution dans ce dépôt.",
  "providerId": "plugin.remux-mkv.example",
  "providerKind": "plugin",
  "capability": "remux",
  "status": "example",
  "tool": {
    "id": "app.mkvtoolnix",
    "version": "1.0.0"
  },
  "permissions": {
    "inputFilesReadOnly": true,
    "outputFilesExclusive": true,
    "network": "none",
    "executableAllowlist": ["mkvmerge"],
    "secretsInArgv": false,
    "secretsInConsoleCapture": false,
    "filesystem": "sandbox-volumes-only"
  },
  "parameters": [
    {
      "id": "source",
      "type": "file",
      "direction": "input",
      "required": true,
      "mediaType": "video/x-matroska",
      "fileAccess": "read",
      "allowedInArgv": true,
      "description": "Référence opaque vers un MKV disponible, résolue localement par le runtime."
    },
    {
      "id": "destination",
      "type": "file",
      "direction": "output",
      "required": true,
      "mediaType": "video/x-matroska",
      "fileAccess": "write",
      "allowedInArgv": true,
      "description": "Réservation de sortie propre à la tentative, jamais un chemin client."
    }
  ],
  "inputs": [
    {
      "id": "source",
      "paramId": "source",
      "dataType": "file",
      "mediaType": "video/x-matroska"
    }
  ],
  "outputs": [
    {
      "id": "result",
      "dataType": "file",
      "mediaType": "video/x-matroska",
      "binding": {
        "kind": "fileParam",
        "paramId": "destination"
      }
    }
  ],
  "command": {
    "schemaVersion": "1.1.0",
    "toolId": "app.mkvtoolnix",
    "executable": "mkvmerge",
    "argv": [
      "--output-charset",
      "UTF-8",
      "--disable-track-statistics-tags",
      "--output",
      { "$param": "destination", "as": "filePath" },
      { "$param": "source", "as": "filePath" }
    ],
    "workingDirectory": "invocation",
    "stdin": "closed",
    "shell": false,
    "forbidden": {
      "shell": true,
      "interpolation": true,
      "eval": true,
      "responseFiles": true
    },
    "pathPolicy": {
      "refsOpaque": true,
      "denyDotDot": true,
      "denyOutboundSymlinks": true,
      "denyAbsoluteClientPaths": true,
      "sandboxVolumesOnly": true,
      "generatedPathsMustNotStartWithDashOrAt": true
    },
    "optionPolicy": {
      "mode": "closed-list",
      "allowedFlags": [
        "--output-charset",
        "--disable-track-statistics-tags",
        "--output"
      ],
      "forbidDoubleDashSeparator": true
    },
    "env": [],
    "noGlobalEnvInheritance": true
  },
  "console": {
    "schemaVersion": "1.1.0",
    "streams": {
      "stdout": {
        "capture": true,
        "encoding": "bytes-base64",
        "maxRetainedBytes": 1048576
      },
      "stderr": {
        "capture": true,
        "encoding": "bytes-base64",
        "maxRetainedBytes": 1048576
      }
    },
    "exitCode": {
      "capture": true,
      "successValues": [0],
      "warningValues": [1],
      "nullMeans": [
        "not_started",
        "signalled",
        "unknown_after_worker_loss"
      ]
    },
    "progress": {
      "source": "runtime",
      "maxEvents": 1000,
      "maxEventBytes": 4096
    },
    "secretMasking": {
      "enabled": true,
      "redactionToken": "***",
      "beforePersistence": true,
      "crossChunk": true,
      "failClosed": true
    },
    "limits": {
      "maxTotalRetainedBytes": 2097152,
      "maxObservedBytesPerStream": 1073741824,
      "maxInMemoryBytes": 65536,
      "timeoutSeconds": 3600,
      "cancelGraceSeconds": 5
    },
    "retention": {
      "mode": "ttl",
      "ttlSeconds": 86400,
      "noUnlimitedRetention": true
    },
    "cancellation": {
      "supported": true,
      "signal": "SIGTERM",
      "killAfterGrace": true
    }
  },
  "outputVerification": "remux-equivalent",
  "retryPolicy": "never-automatic",
  "exitDocumentation": "https://mkvtoolnix.download/doc/mkvmerge.html#mkvmerge.exit_codes — 0 succès ; 1 succès avec avertissements (warningsPreserved) ; 2 erreur.",
  "notes": [
    "argv ne contient pas executable ; aucun séparateur -- seul (lu comme fichier par mkvmerge).",
    "0 = succès ; 1 = succès avec avertissements ; 2 = erreur. Vérification des médias avant publication.",
    "MKVToolNix reste le remuxer validé ; FFmpeg réservé aux médias synthétiques de tests. Pas de MP4.",
    "Aucun runtime dans flux-de-fichiers-plugins."
  ]
}
