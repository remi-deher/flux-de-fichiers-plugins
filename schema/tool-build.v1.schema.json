{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flux-de-fichiers.local/schema/tool-build.v1.schema.json",
  "title": "Recette de construction d'outil Option B v1",
  "description": "Déclaration par application utilisée par build-tools.yml pour produire des archives reproductibles et immuables.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "slug",
    "toolId",
    "toolVersion",
    "releaseTagPrefix",
    "source",
    "binaries",
    "probeArgs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "toolId": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "toolVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "releaseTagPrefix": {
      "type": "string",
      "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
      "maxLength": 64
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "debian-bookworm",
            "gpac-git",
            "upstream-archives",
            "cargo-crate"
          ]
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gitRef": {
          "type": "string",
          "minLength": 1
        },
        "archives": {
          "type": "array",
          "minItems": 1,
          "description": "Archives amont officielles, épinglées par SHA-256, extraites dans <extractTo>/ puis exposées par des lanceurs sh à la racine.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "extractTo",
              "upstreamVersion",
              "urls",
              "sha256",
              "stripComponents",
              "entrypoints"
            ],
            "properties": {
              "extractTo": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "maxLength": 64
              },
              "upstreamVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "urls": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x86_64",
                  "aarch64"
                ],
                "properties": {
                  "x86_64": {
                    "type": "string",
                    "pattern": "^https://[^\\s]+$"
                  },
                  "aarch64": {
                    "type": "string",
                    "pattern": "^https://[^\\s]+$"
                  }
                }
              },
              "sha256": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x86_64",
                  "aarch64"
                ],
                "properties": {
                  "x86_64": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "aarch64": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "stripComponents": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "entrypoints": {
                "type": "object",
                "minProperties": 1,
                "description": "Nom du binaire exposé → chemin relatif dans extractTo/.",
                "propertyNames": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._+-]+(/[A-Za-z0-9._+-]+)*$"
                }
              },
              "prune": {
                "type": "array",
                "uniqueItems": true,
                "description": "Motifs glob relatifs à extractTo/ supprimés après extraction.",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9*?._+-]+(/[A-Za-z0-9*?._+-]+)*$"
                }
              },
              "strip": {
                "type": "boolean",
                "description": "Retire les symboles de débogage des fichiers ELF extraits."
              },
              "format": {
                "enum": [
                  "tar.gz",
                  "tar.xz",
                  "binary"
                ],
                "description": "tar.gz par défaut ; binary = exécutable téléchargé tel quel (entrypoints : nom → chemin cible)."
              }
            }
          }
        },
        "crate": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 64
        },
        "crateVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "rustToolchain": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Version de l'image rust:<version>-bookworm utilisée pour compiler (glibc identique à l'image d'exécution)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "debian-bookworm"
              }
            }
          },
          "then": {
            "required": [
              "packages"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "gpac-git"
              }
            }
          },
          "then": {
            "required": [
              "gitRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "upstream-archives"
              }
            }
          },
          "then": {
            "required": [
              "archives"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "cargo-crate"
              }
            }
          },
          "then": {
            "required": [
              "crate",
              "crateVersion",
              "rustToolchain"
            ]
          }
        }
      ]
    },
    "binaries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
      }
    },
    "probeArgs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dataPaths": {
      "type": "array",
      "maxItems": 16,
      "description": "Dossiers de données copiés depuis le conteneur de construction dans l'archive (ex. tessdata).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9._+/-]+$"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._+-]+(/[A-Za-z0-9._+-]+)*$"
          }
        }
      }
    },
    "launcherEnv": {
      "type": "object",
      "maxProperties": 8,
      "description": "Variables posées par un lanceur sh devant chaque binaire ; valeur relative à la racine de l'archive.",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._+-]+(/[A-Za-z0-9._+-]+)*$"
      }
    }
  }
}
