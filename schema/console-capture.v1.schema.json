{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flux-de-fichiers.local/schema/console-capture.v1.schema.json",
  "title": "Capture console v1",
  "description": "Politique effective obligatoire, bornée et masquée. Les valeurs du catalogue sont plafonnées par le nœud ; aucune copie non masquée ni conservation infinie.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "streams",
    "exitCode",
    "progress",
    "secretMasking",
    "limits",
    "retention",
    "cancellation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "streams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdout",
        "stderr"
      ],
      "properties": {
        "stdout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capture",
            "encoding",
            "maxRetainedBytes"
          ],
          "properties": {
            "capture": {
              "const": true
            },
            "encoding": {
              "const": "bytes-base64"
            },
            "maxRetainedBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1073741824
            }
          }
        },
        "stderr": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capture",
            "encoding",
            "maxRetainedBytes"
          ],
          "properties": {
            "capture": {
              "const": true
            },
            "encoding": {
              "const": "bytes-base64"
            },
            "maxRetainedBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1073741824
            }
          }
        }
      }
    },
    "exitCode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture",
        "successValues",
        "warningValues"
      ],
      "properties": {
        "capture": {
          "const": true
        },
        "successValues": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "warningValues": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "uniqueItems": true
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "maxEvents",
        "maxEventBytes"
      ],
      "properties": {
        "source": {
          "enum": [
            "runtime",
            "none"
          ]
        },
        "maxEvents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxEventBytes": {
          "type": "integer",
          "minimum": 128,
          "maximum": 65536
        }
      }
    },
    "secretMasking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "redactionToken",
        "beforePersistence",
        "crossChunk"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "redactionToken": {
          "const": "***"
        },
        "beforePersistence": {
          "const": true
        },
        "crossChunk": {
          "const": true
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxTotalRetainedBytes",
        "maxObservedBytesPerStream",
        "maxInMemoryBytes",
        "timeoutSeconds",
        "cancelGraceSeconds"
      ],
      "properties": {
        "maxTotalRetainedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483648
        },
        "maxObservedBytesPerStream": {
          "type": "integer",
          "minimum": 1
        },
        "maxInMemoryBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "cancelGraceSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "ttlSeconds"
      ],
      "properties": {
        "mode": {
          "const": "ttl"
        },
        "ttlSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 2592000
        }
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported",
        "signal",
        "killAfterGrace"
      ],
      "properties": {
        "supported": {
          "const": true
        },
        "signal": {
          "const": "SIGTERM"
        },
        "killAfterGrace": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "stream": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "encoding",
            "observedBytes",
            "retainedBytes",
            "truncated",
            "redacted",
            "data"
          ],
          "properties": {
            "kind": {
              "const": "inline"
            },
            "encoding": {
              "const": "bytes-base64"
            },
            "observedBytes": {
              "type": "integer",
              "minimum": 0
            },
            "retainedBytes": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            },
            "redacted": {
              "type": "boolean"
            },
            "data": {
              "type": "string",
              "contentEncoding": "base64",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
              "maxLength": 22369624
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "encoding",
            "observedBytes",
            "retainedBytes",
            "truncated",
            "redacted",
            "file"
          ],
          "properties": {
            "kind": {
              "const": "artifact"
            },
            "encoding": {
              "const": "bytes-base64"
            },
            "observedBytes": {
              "type": "integer",
              "minimum": 0
            },
            "retainedBytes": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            },
            "redacted": {
              "type": "boolean"
            },
            "file": {
              "$ref": "file-ref.v1.schema.json"
            }
          }
        }
      ]
    }
  }
}
