{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flux-de-fichiers.local/schema/manifest.v1.1.schema.json",
  "title": "Manifestes v1 et extension v1.1",
  "description": "Lecture ascendante stricte : branche 1.0.0 inchangée, nouveaux champs uniquement avec schemaVersion 1.1.0. Un ancien lecteur doit refuser 1.1.0 proprement.",
  "oneOf": [
    {
      "$ref": "manifest.v1.schema.json"
    },
    {
      "$ref": "#/$defs/extended"
    }
  ],
  "$defs": {
    "extended": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "type",
        "version",
        "name",
        "description",
        "author",
        "license"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 128,
          "description": "Identifiant stable unique dans le catalogue."
        },
        "type": {
          "type": "string",
          "enum": [
            "plugin",
            "flow",
            "preset",
            "resource.font",
            "resource.image",
            "resource.audio",
            "resource.color",
            "resource.language",
            "resource.template",
            "app",
            "block",
            "pack"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$",
          "description": "Version semver de l'élément."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Identifiant SPDX ou mention explicite (ex. UNLICENSED pour un exemple local)."
        },
        "icon": {
          "type": "string",
          "description": "Chemin relatif vers une icône dans le paquet de l'élément."
        },
        "previews": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "description": "Chemin relatif vers un aperçu."
          }
        },
        "files": {
          "type": "array",
          "description": "Fichiers fournis par l'élément (chemins relatifs).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "role"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "primary",
                  "config",
                  "schema",
                  "docs",
                  "asset",
                  "deploy",
                  "operation",
                  "block"
                ]
              },
              "mediaType": {
                "type": "string"
              }
            }
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "appMin": {
              "type": "string",
              "description": "Version minimale de l'application (semver)."
            },
            "appMax": {
              "type": "string",
              "description": "Version maximale exclusive de l'application (semver)."
            },
            "platforms": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "linux/amd64",
                  "linux/arm64"
                ]
              }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Identifiant catalogue d'une dépendance."
              },
              "versionRange": {
                "type": "string",
                "description": "Plage semver illustrative (ex. ^1.0.0)."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "plugin",
                  "resource",
                  "runtime",
                  "app",
                  "flow",
                  "preset",
                  "block",
                  "pack"
                ]
              },
              "optional": {
                "type": "boolean",
                "default": false,
                "description": "Dépendance proposée, jamais imposée : l'installation du plugin n'est pas bloquée si elle manque."
              }
            }
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "Empreinte du paquet ou du fichier primaire (si fournie)."
            }
          }
        },
        "tool": {
          "type": "object",
          "description": "Métadonnées spécifiques aux applications (type app : MKVToolNix, FFmpeg…).",
          "additionalProperties": false,
          "properties": {
            "capability": {
              "type": "string",
              "enum": [
                "remux",
                "database",
                "transcode",
                "analyze",
                "other"
              ]
            },
            "interface": {
              "type": "string",
              "description": "Nom de l'interface applicative attendue (voir docs/interfaces-outils.md)."
            },
            "invocation": {
              "type": "string",
              "enum": [
                "docker-image",
                "host-binary",
                "compose-service",
                "none"
              ],
              "description": "Mode d'invocation prévu ; none = fiche descriptive seule."
            },
            "currentChoice": {
              "type": "boolean",
              "description": "true si c'est le choix opérationnel actuel de l'application."
            }
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
            "maxLength": 512
          },
          "maxItems": 64
        },
        "blocks": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
                "maxLength": 512
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "maxItems": 64,
          "description": "Blocs appartenant à ce plugin : chemin d'un fichier de bloc ou fiche intégrée. Un bloc n'existe pas hors d'un plugin."
        },
        "pack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "installation",
            "runtimeImplemented"
          ],
          "properties": {
            "kind": {
              "enum": [
                "declarative-bundle",
                "leptos-assets"
              ]
            },
            "installation": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
              "maxLength": 512
            },
            "runtimeImplemented": {
              "type": "boolean"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "pack"
              }
            }
          },
          "then": {
            "required": [
              "pack"
            ]
          }
        }
      ]
    }
  }
}
