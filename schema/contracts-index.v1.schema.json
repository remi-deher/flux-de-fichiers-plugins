{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flux-de-fichiers.local/schema/contracts-index.v1.schema.json",
  "title": "Index complémentaire des contrats v1",
  "description": "Complément explicite du catalogue v1, sans modifier ses fiches. Les anciens lecteurs continuent de lire index.json ; les lecteurs de contrats résolvent aussi ce document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "legacyIndex",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "legacyIndex": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
      "maxLength": 512
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "type",
          "manifestPath",
          "contracts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
          },
          "type": {
            "enum": [
              "plugin",
              "block",
              "flow",
              "preset",
              "pack"
            ]
          },
          "manifestPath": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
            "maxLength": 512
          },
          "contracts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "path"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "operation",
                    "block",
                    "flow",
                    "preset",
                    "app-installation"
                  ]
                },
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
                  "maxLength": 512
                }
              }
            },
            "minItems": 1,
            "maxItems": 64
          }
        }
      },
      "minItems": 1,
      "maxItems": 1024
    }
  }
}
