{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flux-de-fichiers.local/schema/block-runtime.v1.schema.json",
  "title": "Bloc composable runtime v1.1",
  "description": "Contrat déclaratif des blocs chargés par flux-de-fichiers (src/plugins/blocks.rs).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "description",
    "category",
    "operationId",
    "operationVersion",
    "sockets",
    "ui"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "category": {
      "enum": [
        "media",
        "data",
        "io",
        "other"
      ]
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "operationVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "sockets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "outputs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/socket"
          }
        },
        "outputs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/socket"
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "fields"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "hasInput": {
          "type": "boolean"
        },
        "terminal": {
          "type": "boolean"
        },
        "implicitStart": {
          "type": "boolean"
        },
        "ports": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        },
        "icon": {
          "type": "string",
          "maxLength": 120
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "suggestedNext": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
          }
        },
        "fields": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/uiField"
          }
        }
      }
    }
  },
  "$defs": {
    "socket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "dataType"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "dataType": {
          "enum": [
            "file",
            "data",
            "string",
            "integer",
            "number",
            "boolean",
            "json"
          ]
        },
        "mediaType": {
          "type": "string",
          "pattern": "^([a-z0-9!#$&^_.+-]+|\\*)/([a-z0-9!#$&^_.+-]+|\\*)$",
          "maxLength": 128
        },
        "operationInput": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$",
          "maxLength": 64
        },
        "operationOutput": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$",
          "maxLength": 64
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "dataType": {
                "const": "file"
              }
            },
            "required": [
              "dataType"
            ]
          },
          "then": {
            "required": [
              "mediaType"
            ]
          }
        }
      ]
    },
    "uiField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_]*$",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "enum": [
            "string",
            "boolean",
            "select",
            "range",
            "headers",
            "worker",
            "condition",
            "flow"
          ]
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "placeholder": {
          "type": "string",
          "maxLength": 120
        },
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "value": {
                "type": "string",
                "maxLength": 256
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "range"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "min",
              "max"
            ]
          }
        }
      ]
    }
  }
}
