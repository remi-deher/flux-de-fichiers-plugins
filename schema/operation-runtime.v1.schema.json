{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flux-de-fichiers.local/schema/operation-runtime.v1.schema.json",
  "title": "Contrat d'exécution déclaratif d'opération",
  "description": "Miroir exact du contrat OperationContract lu par le moteur Rust (src/flows/contract.rs).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "providerId",
    "providerKind",
    "capability",
    "status",
    "runtime"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "providerId": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "providerKind": {
      "enum": [
        "plugin",
        "app",
        "script"
      ]
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "status": {
      "enum": [
        "validated",
        "example",
        "pending-decision",
        "rejected"
      ]
    },
    "runtime": {
      "oneOf": [
        {
          "$ref": "#/$defs/primitiveRuntime"
        },
        {
          "$ref": "#/$defs/binaryRuntime"
        },
        {
          "$ref": "#/$defs/httpRuntime"
        },
        {
          "$ref": "#/$defs/scriptRuntime"
        }
      ]
    },
    "exposes": {
      "$ref": "#/$defs/exposedVariables"
    }
  },
  "$defs": {
    "primitiveRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "primitive"
      ],
      "properties": {
        "kind": {
          "const": "primitive"
        },
        "primitive": {
          "enum": [
            "entry",
            "terminal",
            "condition",
            "capability",
            "relay",
            "set-variable",
            "sub-flow"
          ]
        },
        "defaults": {
          "type": "object"
        }
      }
    },
    "binaryRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "executable",
        "executionMode",
        "argv"
      ],
      "properties": {
        "kind": {
          "const": "binary"
        },
        "defaultFallback": {
          "type": "boolean"
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
            }
          }
        },
        "pathTools": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "description": "Outils du cache placés en tête du PATH de la commande (ex. ffmpeg appelé par l'outil principal) ; ils comptent parmi les outils requis du flux.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
                "maxLength": 128
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
              }
            }
          }
        },
        "executable": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "maxLength": 80
        },
        "envOverride": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "maxLength": 64
        },
        "executionMode": {
          "enum": [
            "staged-output",
            "in-place",
            "probe-primary",
            "probe-enrich"
          ]
        },
        "probeFormat": {
          "enum": [
            "json"
          ]
        },
        "probeRequirePaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "probeEnrichmentKey": {
          "type": "string",
          "minLength": 1
        },
        "probeMatch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extensions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "priority": {
              "type": "integer"
            }
          }
        },
        "outputExtension": {
          "type": "string",
          "minLength": 1
        },
        "outputContentType": {
          "type": "string",
          "minLength": 1
        },
        "outputFilename": {
          "type": "string",
          "minLength": 1
        },
        "postValidate": {
          "enum": [
            "none",
            "non-empty",
            "valid-probe",
            "magic-bytes",
            "probe-preserve"
          ]
        },
        "postValidateMagic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "offset",
            "ascii"
          ],
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "ascii": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "postValidatePreservePaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "durationRules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "scale"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "skipWhenUnchanged": {
          "type": "boolean"
        },
        "errorCode": {
          "enum": [
            "operation_failed",
            "webhook_failed",
            "integration_failed",
            "source_integrity",
            "transfer_failed",
            "probe_unavailable",
            "lease_expired",
            "missing_source_fingerprint"
          ]
        },
        "successMessage": {
          "type": "string"
        },
        "warningMessage": {
          "type": "string"
        },
        "defaults": {
          "type": "object"
        },
        "customArgsForbidden": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "derived": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "kind",
              "inputs"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "inputs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "table": {
                "type": "object"
              },
              "default": {
                "$ref": "common.v1.schema.json#/$defs/value"
              }
            }
          }
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/argItem"
          }
        },
        "retryFallback": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "when"
            ],
            "properties": {
              "when": {
                "$ref": "#/$defs/conditionClause"
              },
              "overrides": {
                "type": "object"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "console": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "progressFormat": {
              "enum": [
                "none",
                "elapsed-time",
                "fraction-100",
                "percent-line"
              ]
            },
            "progressStream": {
              "enum": [
                "stdout",
                "stderr"
              ]
            },
            "successExitCodes": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "warningExitCodes": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          }
        }
      }
    },
    "argItem": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "param"
          ],
          "properties": {
            "param": {
              "type": "string",
              "minLength": 1
            },
            "as": {
              "enum": [
                "filePath",
                "safeCustomArgs",
                "string"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format"
          ],
          "properties": {
            "format": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "when",
            "then"
          ],
          "properties": {
            "when": {
              "$ref": "#/$defs/conditionClause"
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/argItem"
              }
            },
            "else": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/argItem"
              }
            }
          }
        }
      ]
    },
    "conditionClause": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/conditionClause"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/conditionClause"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "param"
          ],
          "properties": {
            "param": {
              "type": "string",
              "minLength": 1
            },
            "eq": {
              "$ref": "common.v1.schema.json#/$defs/value"
            },
            "neq": {
              "$ref": "common.v1.schema.json#/$defs/value"
            },
            "in": {
              "type": "array",
              "items": {
                "$ref": "common.v1.schema.json#/$defs/value"
              }
            },
            "endsWith": {
              "type": "string"
            },
            "startsWith": {
              "type": "string"
            },
            "truthy": {
              "type": "boolean"
            },
            "nonEmpty": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "httpRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "steps"
      ],
      "properties": {
        "kind": {
          "const": "http"
        },
        "settingsPluginId": {
          "type": "string",
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
        },
        "requiredSettings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "errorCode": {
          "enum": [
            "operation_failed",
            "webhook_failed",
            "integration_failed",
            "source_integrity",
            "transfer_failed",
            "probe_unavailable",
            "lease_expired",
            "missing_source_fingerprint"
          ]
        },
        "failOnErrorParam": {
          "type": "string",
          "minLength": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "pathMapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "localKey",
            "remoteKey",
            "outputVar"
          ],
          "properties": {
            "localKey": {
              "type": "string",
              "minLength": 1
            },
            "remoteKey": {
              "type": "string",
              "minLength": 1
            },
            "outputVar": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "defaults": {
          "type": "object"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "method"
            ],
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "query": {
                "type": "object"
              },
              "headers": {
                "type": "object"
              },
              "mergeCustomHeaders": {
                "type": "boolean"
              },
              "body": {},
              "extract": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "pathField",
                  "idField",
                  "targetVar",
                  "saveAs"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "arrayPathPrefix",
                      "arrayRelativePath"
                    ]
                  },
                  "pathField": {
                    "type": "string",
                    "minLength": 1
                  },
                  "absolutePathField": {
                    "type": "string"
                  },
                  "basePathVar": {
                    "type": "string"
                  },
                  "idField": {
                    "type": "string",
                    "minLength": 1
                  },
                  "targetVar": {
                    "type": "string",
                    "minLength": 1
                  },
                  "saveAs": {
                    "type": "string",
                    "minLength": 1
                  },
                  "savePathAs": {
                    "type": "string"
                  },
                  "skipMessage": {
                    "type": "string"
                  }
                }
              },
              "successMessage": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "scriptRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "script"
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "pathTools": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "description": "Outils du cache placés en tête du PATH de la commande (ex. ffmpeg appelé par l'outil principal) ; ils comptent parmi les outils requis du flux.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
                "maxLength": 128
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
              }
            }
          }
        },
        "executable": {
          "type": "string"
        },
        "interpreter": {
          "enum": [
            "bash",
            "sh",
            "python3",
            "node",
            "deno",
            "bun",
            "pwsh"
          ]
        },
        "entrypoint": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errorCode": {
          "type": "string"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "defaults": {
          "type": "object"
        },
        "acceptsNonMedia": {
          "type": "boolean",
          "description": "Le script accepte une entrée non média (ex. archive) : le flux tolère l'échec de la sonde initiale ; le fichier produit est inspecté ensuite."
        },
        "variables": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/scriptVariable"
          },
          "description": "Variables typées du script, saisies dans le nœud du flux ; valeurs lues dans config sur stdin."
        },
        "requires": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/scriptRequirement"
          },
          "description": "Variables exposées par des plugins que le script consomme ; dépendance dure."
        },
        "dependenciesUnverified": {
          "type": "boolean",
          "description": "Script intégré sans ses dépendances : elles ne sont ni contrôlées ni installées."
        }
      }
    },
    "exposedVariables": {
      "type": "object",
      "additionalProperties": false,
      "description": "Variables que l'opération expose aux scripts via mediaInfo (ADR 0025 de Forgearr). Les règles sémantiques (préfixe, doublons, groupes, fixture, montée de version) sont contrôlées par scripts/check_catalogue.py.",
      "required": [
        "namespace",
        "contractVersion"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 64,
          "not": {
            "enum": [
              "nodes"
            ]
          },
          "description": "Espace de noms des références : {{espace.nom}}. Propre au plugin, jamais « nodes »."
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "description": "MAJEUR.MINEUR.CORRECTIF ; un retrait, un renommage ou un changement de type monte le majeur."
        },
        "variables": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/exposedVariable"
          }
        }
      }
    },
    "exposedVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,7}$",
          "description": "Nom relatif à l'espace de noms (video.codec)."
        },
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "type": {
          "enum": [
            "text",
            "multiline",
            "number",
            "boolean",
            "choice"
          ],
          "default": "text"
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+(\\[(\\*|[0-9]+|@?[A-Za-z0-9_-]+=[A-Za-z0-9_ -]+)\\])?(\\.[A-Za-z0-9_-]+(\\[(\\*|[0-9]+|@?[A-Za-z0-9_-]+=[A-Za-z0-9_ -]+)\\])?){0,7}$",
          "description": "Requête dans mediaInfo : a.b, arr[0], arr[*] ou arr[clé=valeur] (ex. mediainfo.media.track[@type=Video].Format)."
        },
        "deprecated": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Message de dépréciation : la variable reste lue mais les flux et scripts qui l'utilisent sont avertis. Un retrait n'est autorisé qu'après une version qui la déprécie, ou avec une montée de version majeure du contrat."
        },
        "replacedBy": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,7}$",
          "description": "Nom relatif de la variable qui la remplace dans le même contrat ; exige deprecated."
        }
      }
    },
    "scriptVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 64
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "multiline",
            "number",
            "boolean",
            "choice",
            "secret"
          ],
          "default": "text"
        },
        "default": {
          "description": "Valeur du type de la variable ; interdite pour un secret."
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "scriptRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable",
        "provider"
      ],
      "properties": {
        "variable": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}$",
          "description": "Référence complète : espace.nom."
        },
        "provider": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
          "maxLength": 64,
          "description": "Identifiant du plugin fournisseur."
        },
        "contractMajor": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "indexUrl"
          ],
          "description": "Dépôt qui publie le fournisseur, s'il n'est pas celui du script ; jamais ajouté automatiquement.",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
              "maxLength": 64
            },
            "indexUrl": {
              "type": "string",
              "pattern": "^https?://\\S+/index\\.json$"
            }
          }
        }
      }
    }
  }
}
