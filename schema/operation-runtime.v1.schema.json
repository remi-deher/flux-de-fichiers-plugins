{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flux-de-fichiers.local/schema/operation-runtime.v1.schema.json",
  "title": "Contrat d'exécution déclaratif d'opération",
  "description": "Miroir exact du contrat OperationContract lu par le moteur Rust (src/flows/contract.rs).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "providerId",
    "providerKind",
    "capability",
    "status",
    "runtime"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "providerId": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "providerKind": {
      "enum": [
        "plugin",
        "app"
      ]
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "status": {
      "enum": [
        "validated",
        "example",
        "pending-decision",
        "rejected"
      ]
    },
    "runtime": {
      "oneOf": [
        {
          "$ref": "#/$defs/primitiveRuntime"
        },
        {
          "$ref": "#/$defs/binaryRuntime"
        },
        {
          "$ref": "#/$defs/httpRuntime"
        }
      ]
    }
  },
  "$defs": {
    "primitiveRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "primitive"
      ],
      "properties": {
        "kind": {
          "const": "primitive"
        },
        "primitive": {
          "enum": [
            "entry",
            "terminal",
            "condition"
          ]
        },
        "defaults": {
          "type": "object"
        }
      }
    },
    "binaryRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "executable",
        "executionMode",
        "argv"
      ],
      "properties": {
        "kind": {
          "const": "binary"
        },
        "defaultFallback": {
          "type": "boolean"
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
            }
          }
        },
        "executable": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "maxLength": 80
        },
        "envOverride": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "maxLength": 64
        },
        "executionMode": {
          "enum": [
            "staged-output",
            "in-place",
            "probe-primary",
            "probe-enrich"
          ]
        },
        "probeFormat": {
          "enum": [
            "json"
          ]
        },
        "probeRequirePaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "probeEnrichmentKey": {
          "type": "string",
          "minLength": 1
        },
        "probeMatch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extensions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "priority": {
              "type": "integer"
            }
          }
        },
        "outputExtension": {
          "type": "string",
          "minLength": 1
        },
        "outputContentType": {
          "type": "string",
          "minLength": 1
        },
        "outputFilename": {
          "type": "string",
          "minLength": 1
        },
        "postValidate": {
          "enum": [
            "none",
            "non-empty",
            "valid-probe",
            "magic-bytes",
            "probe-preserve"
          ]
        },
        "postValidateMagic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "offset",
            "ascii"
          ],
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "ascii": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "postValidatePreservePaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "durationRules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "scale"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "skipWhenUnchanged": {
          "type": "boolean"
        },
        "errorCode": {
          "enum": [
            "operation_failed",
            "webhook_failed",
            "integration_failed",
            "source_integrity",
            "transfer_failed",
            "probe_unavailable",
            "lease_expired",
            "missing_source_fingerprint"
          ]
        },
        "successMessage": {
          "type": "string"
        },
        "warningMessage": {
          "type": "string"
        },
        "defaults": {
          "type": "object"
        },
        "customArgsForbidden": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "derived": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "kind",
              "inputs"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "inputs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "table": {
                "type": "object"
              },
              "default": {
                "$ref": "common.v1.schema.json#/$defs/value"
              }
            }
          }
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/argItem"
          }
        },
        "retryFallback": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "when"
            ],
            "properties": {
              "when": {
                "$ref": "#/$defs/conditionClause"
              },
              "overrides": {
                "type": "object"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "console": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "progressFormat": {
              "enum": [
                "none",
                "elapsed-time",
                "fraction-100",
                "percent-line"
              ]
            },
            "progressStream": {
              "enum": [
                "stdout",
                "stderr"
              ]
            },
            "successExitCodes": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "warningExitCodes": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          }
        }
      }
    },
    "argItem": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "param"
          ],
          "properties": {
            "param": {
              "type": "string",
              "minLength": 1
            },
            "as": {
              "enum": [
                "filePath",
                "safeCustomArgs",
                "string"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format"
          ],
          "properties": {
            "format": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "when",
            "then"
          ],
          "properties": {
            "when": {
              "$ref": "#/$defs/conditionClause"
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/argItem"
              }
            },
            "else": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/argItem"
              }
            }
          }
        }
      ]
    },
    "conditionClause": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/conditionClause"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/conditionClause"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "param"
          ],
          "properties": {
            "param": {
              "type": "string",
              "minLength": 1
            },
            "eq": {
              "$ref": "common.v1.schema.json#/$defs/value"
            },
            "neq": {
              "$ref": "common.v1.schema.json#/$defs/value"
            },
            "in": {
              "type": "array",
              "items": {
                "$ref": "common.v1.schema.json#/$defs/value"
              }
            },
            "endsWith": {
              "type": "string"
            },
            "startsWith": {
              "type": "string"
            },
            "truthy": {
              "type": "boolean"
            },
            "nonEmpty": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "httpRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "steps"
      ],
      "properties": {
        "kind": {
          "const": "http"
        },
        "settingsPluginId": {
          "type": "string",
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
        },
        "requiredSettings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "errorCode": {
          "enum": [
            "operation_failed",
            "webhook_failed",
            "integration_failed",
            "source_integrity",
            "transfer_failed",
            "probe_unavailable",
            "lease_expired",
            "missing_source_fingerprint"
          ]
        },
        "failOnErrorParam": {
          "type": "string",
          "minLength": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "pathMapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "localKey",
            "remoteKey",
            "outputVar"
          ],
          "properties": {
            "localKey": {
              "type": "string",
              "minLength": 1
            },
            "remoteKey": {
              "type": "string",
              "minLength": 1
            },
            "outputVar": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "defaults": {
          "type": "object"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "method"
            ],
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "query": {
                "type": "object"
              },
              "headers": {
                "type": "object"
              },
              "mergeCustomHeaders": {
                "type": "boolean"
              },
              "body": {},
              "extract": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "pathField",
                  "idField",
                  "targetVar",
                  "saveAs"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "arrayPathPrefix",
                      "arrayRelativePath"
                    ]
                  },
                  "pathField": {
                    "type": "string",
                    "minLength": 1
                  },
                  "absolutePathField": {
                    "type": "string"
                  },
                  "basePathVar": {
                    "type": "string"
                  },
                  "idField": {
                    "type": "string",
                    "minLength": 1
                  },
                  "targetVar": {
                    "type": "string",
                    "minLength": 1
                  },
                  "saveAs": {
                    "type": "string",
                    "minLength": 1
                  },
                  "savePathAs": {
                    "type": "string"
                  },
                  "skipMessage": {
                    "type": "string"
                  }
                }
              },
              "successMessage": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
